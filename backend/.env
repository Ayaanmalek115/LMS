PORT=5000
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/library_db
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/library_db?retryWrites=true&w=majority

# If set to "auto" or "true", backend will launch an in-memory MongoDB server if local/atlas is not reachable
AUTO_IN_MEMORY_DB=true
